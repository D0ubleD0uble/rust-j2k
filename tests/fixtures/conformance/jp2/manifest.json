  "_comment": "ISO/IEC 15444-4 Annex G JP2 reader files. Generated by regenerate.py; do not edit by hand. See ../README.md and ../COPYRIGHT.",
  "compliance_class": 1,
  "provenance": {
    "files": {
      "repo": "uclouvain/openjpeg-data",
      "commit": "39524bd3a601d90ed8e0177559400d23945f96a9",
      "path": "input/conformance/file{1..9}.jp2"
    },
    "references": {
      "repo": "uclouvain/openjpeg-data",
      "commit": "39524bd3a601d90ed8e0177559400d23945f96a9",
      "path": "baseline/conformance/jp2_{1..9}.tif",
      "conversion": "8-bit RGB TIFF read with Pillow, written as one unsigned 8-bit PGX plane per channel; greyscale files (4, 6, 8) keep one plane after asserting the three channels are identical",
      "oracle_command": "opj_decompress -i fileN.jp2 -o fileN.tif -p 8S -force-rgb"
    },
    "bounds": {
      "repo": "uclouvain/openjpeg",
      "path": "tests/conformance/CMakeLists.txt",
      "block": "Tests about JP2 file (Part 4 Table G.1): compare_images -n 3 -p 4:4:4 -m 1:1:1",
      "note": "files 1, 4, 6 and 9 are graded bit-exact (measured: the OpenJPEG decode equals the reference); the rest use PAE 4 / MSE 1"
    },
    "as_coded": {
      "files": "3, 5, 7, 8 (file2 waits on its cdef)",
      "oracle_command": "the jp2c payload as a bare codestream: opj_decompress -i cs.j2k -o out.pgx; the sub-sampled file (3) one component at a time with -c K",
      "note": "codestream samples at the native component size and depth, no colour conversion and no shift. -c avoids opj_decompress's sYCC heuristic but skips the inverse MCT, so it is used only for the sub-sampled file (mct 0); the bare codestream carries no ICC"
    },
    "features": {
      "tool": "opj_dump -i + direct marker-segment walk of the jp2c payload",
      "note": "boxes and colour are read from the JP2 box layer directly"
    },
    "license": "Conformance-only grant; see ../COPYRIGHT. Excluded from the published crate via Cargo.toml `exclude`."
  },
